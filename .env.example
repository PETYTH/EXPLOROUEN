# Configuration de base
NODE_ENV=development
PORT=5000

# Base de données PostgreSQL
DATABASE_URL="postgresql://username:password@localhost:5432/explorouen_db?schema=public"
# Pour Docker:
# DATABASE_URL="postgresql://explorouen:explorouen_password@localhost:5432/explorouen_db?schema=public"

# Base de données MongoDB (pour messagerie, avis, contacts, notations)
MONGODB_URL="mongodb://localhost:27017/explorouen_mongo"
# Pour Docker avec authentification:
# MONGODB_URL="mongodb://explorouen:explorouen_password@localhost:27017/explorouen_mongo?authSource=admin"
# Pour MongoDB Atlas (production):
# MONGODB_URL="mongodb+srv://username:password@cluster.mongodb.net/explorouen?retryWrites=true&w=majority"

# JWT
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d

# Redis (pour le cache de performance)
REDIS_URL=redis://localhost:6379
# Pour Docker avec mot de passe:
# REDIS_URL=redis://:explorouen_redis_password@localhost:6379
# Pour Redis Cloud/Upstash (production):
# REDIS_URL=redis://:password@host:port

# Email Configuration
# Pour la production (Resend)
RESEND_API_KEY=re_WRjtbRpf_PMGVFEir5RGGTxKwr5n2YEsJ
FROM_EMAIL=contact@explorouen.fr

# Mailtrap Configuration
MAILTRAP_USER=f001ad3b8b23cf  # Généralement un identifiant comme "1234567890ab"
MAILTRAP_PASS=02bef102225a2f
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
EMAIL_PROVIDER=mailtrap

# Upload de fichiers
